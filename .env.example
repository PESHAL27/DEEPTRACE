# ==============================================================================
# DEEPTRACE — Media Forensics Environment Configuration Template
# ==============================================================================
# Copy this file to .env in your deployment environment and adjust values.
# NEVER commit real credentials, tokens, or secret keys to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Network Configuration
# ------------------------------------------------------------------------------
# HOST: IP address to bind FastAPI ASGI server (0.0.0.0 for container/production)
HOST=0.0.0.0
# PORT: Port number for FastAPI ASGI server
PORT=8000

# ------------------------------------------------------------------------------
# 2. Frontend Configuration (Used during Vite build and browser runtime)
# ------------------------------------------------------------------------------
# VITE_API_BASE_URL: URL to backend API endpoint
VITE_API_BASE_URL=http://127.0.0.1:8000/api
# VITE_MEDIA_BASE_URL: Base URL for media assets (/uploads/...)
VITE_MEDIA_BASE_URL=http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# 3. Cross-Origin Resource Sharing (CORS) Configuration
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins.
# In production, set to your exact domain(s), e.g.: https://deeptrace.example.com
# Leave empty for development defaults (localhost:5173, 127.0.0.1:5173, etc.)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 4. Storage & Persistence Configuration
# ------------------------------------------------------------------------------
# UPLOADS_DIR: Directory where uploaded media and generated artifacts reside
# (Can be relative to backend/ directory or an absolute path/persistent volume mount)
UPLOADS_DIR=uploads

# RESULTS_DIR: Directory where analysis and evaluation result snapshots are stored
RESULTS_DIR=results

# ------------------------------------------------------------------------------
# 5. Machine Learning Model Checkpoint Paths
# ------------------------------------------------------------------------------
# Optional overrides for model files. If unset, defaults to project directory structure.
# DEEPFAKE_MODEL_DIR: Root path to deepfake_model/ directory
DEEPFAKE_MODEL_DIR=

# XCEPTION_WEIGHTS_PATH: Pretrained DeepfakeBench Xception weights file
XCEPTION_WEIGHTS_PATH=

# XCEPTION_CONFIG_PATH: YAML architecture definition for Xception backbone
XCEPTION_CONFIG_PATH=

# MESO4_CHECKPOINT_PATH: Pretrained DeepfakeBench MesoNet-4 comparison model weights
MESO4_CHECKPOINT_PATH=

# YUNET_MODEL_PATH: OpenCV YuNet ONNX face detection model
YUNET_MODEL_PATH=

# ------------------------------------------------------------------------------
# 6. Operational & Forensic Decision Thresholds
# ------------------------------------------------------------------------------
# DEEPFAKE_THRESHOLD: Decision boundary separating authentic (< threshold)
# from manipulated (>= threshold). Production binary decision threshold: 0.50.
DEEPFAKE_THRESHOLD=0.50

# VIDEO_SAMPLE_INTERVAL: Frame sampling stride (e.g. 15 = analyze every 15th frame)
VIDEO_SAMPLE_INTERVAL=15

# MAX_ANALYZED_FRAMES: Upper bound on sampled frames analyzed per video
MAX_ANALYZED_FRAMES=30

# ------------------------------------------------------------------------------
# 7. Security, Ingestion & Resource Guards
# ------------------------------------------------------------------------------
# MAX_IMAGE_SIZE_BYTES: Maximum allowed still image upload (20 MB default)
MAX_IMAGE_SIZE_BYTES=20971520

# MAX_VIDEO_SIZE_BYTES: Maximum allowed video upload (100 MB default)
MAX_VIDEO_SIZE_BYTES=104857600

# MAX_IMAGE_PIXELS: Maximum allowed image pixel count (Decompression bomb guard: 25 Megapixels)
MAX_IMAGE_PIXELS=25000000

# MAX_IMAGE_DIMENSION: Maximum allowed width or height in pixels (8192 default)
MAX_IMAGE_DIMENSION=8192

# MAX_VIDEO_DIMENSION: Maximum allowed video frame width or height (4096 default)
MAX_VIDEO_DIMENSION=4096

# MAX_VIDEO_DURATION_SECONDS: Maximum allowed video length in seconds (600 = 10 min)
MAX_VIDEO_DURATION_SECONDS=600.0

# MAX_VIDEO_FPS: Maximum allowed frame rate (120 FPS default)
MAX_VIDEO_FPS=120.0

# MAX_BENCHMARK_SAMPLES: Maximum workload size per benchmark execution (500 default)
MAX_BENCHMARK_SAMPLES=500
